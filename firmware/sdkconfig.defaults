# sdkconfig.defaults — BLE-only slim build (design 03 §3.8, trimmed).
# Per-board additions live in sdkconfig.defaults.heltec-v3; the generated
# root sdkconfig is never committed.
#
# There is deliberately no Wi-Fi, lwIP, esp_netif, mDNS, httpd, WebSocket,
# MQTT, coex or OTA configuration here — none of that is compiled into this
# image. The radio is LoRa (SX1262) + BLE only.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Partition table (03 §3.5, slimmed): dual OTA app slots retained so a future
# wired/USB update keeps its known-good fallback; `cooks` absorbs the old
# `www` carve-out.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE: NimBLE, not Bluedroid (D6) — ~100 KB of SRAM on a no-PSRAM part.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# The Bridge Control Service (protocol/ble-gatt.md). Peripheral only: we
# advertise and serve, we never scan or connect out. Dropping the
# central/observer roles is the cheapest RAM in the build.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# LE Secure Connections with passkey entry, IO capability DisplayOnly: the
# OLED shows the code, so the LTK is MITM-authenticated. Legacy pairing is
# OFF — it cannot produce an authenticated key.
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
# Bonds persist in NVS, capped at 3 phones (§3). NimBLE's own namespace is
# the one documented exception to 03 §3.6.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
# 247 so history_preview's 244 B + 3 fits a single ATT PDU (§4). A peer that
# refuses still gets live_state, which is 16 B by design (R7).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Coredump partition (03 §3.7).
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Power: tickless idle + DFS-capable.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# ONE version string, read by app_ui, app_ble and the boot log via
# esp_app_get_description()->version (F14.7 discipline, kept).
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"

# Watchdog: a task that blocks past its budget panics loudly.
CONFIG_ESP_TASK_WDT_INIT=y