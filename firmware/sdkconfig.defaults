# sdkconfig.defaults — deltas from IDF defaults per design 03 §3.8.
# Per-board additions live in sdkconfig.defaults.heltec-v3; the generated
# root sdkconfig is never committed.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Partition table (03 §3.5) — OTA slots + reserved www + cooks history
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE: NimBLE, not Bluedroid (D6) — ~100 KB of SRAM on a no-PSRAM part
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# F10.4/F10.5 — the Bridge Control Service (protocol/ble-gatt.md).
# Peripheral only: we advertise and serve, we never scan or connect out.
# Dropping the central/observer roles is the cheapest RAM in the build.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# LE Secure Connections with passkey entry, IO capability DisplayOnly:
# the OLED shows the code, so the LTK is MITM-authenticated. Legacy
# pairing is OFF — it cannot produce an authenticated key, and
# wifi_config/device_control require one (ble-gatt §3).
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
# Bonds persist in NVS, capped at 3 phones (§3). The store is NimBLE's
# own namespace — the one documented exception to 03 §3.6, see §3.6.1.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
# 247 so history_preview's 244 B + 3 fits a single ATT PDU (§4). A peer
# that refuses still gets live_state, which is 16 B by design (R7).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Wi-Fi + BLE share the 2.4 GHz radio
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# WebSocket support in esp_http_server
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# OTA safety: a fresh image is pending-verify until the 03 §3.7 health gate
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# F14.7 — ONE version string. Without this the app descriptor carries a
# git-describe abbreviation (`e32feb0`) while /status.fw carried a string
# literal, which is two sources of truth for "what is running" and a third
# once the OTA reply names the image it is about to install. 10 §10.8 makes
# firmware and app share a version because the API contract binds them
# (06 §6.5) — so this is the one line a release bumps, and everything else
# reads esp_app_get_description()->version.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"

# V3.1 — uxTaskGetSystemState(), which /api/v1/debug/tasks needs to report
# stack watermarks for the tasks the application did NOT create: the IDF's
# own httpd, the NimBLE host, and the event loop. Those are precisely the
# rows main/tasks.h cannot account for and 01 §1.4 had to estimate. A few
# bytes per TCB buys the 24 h soak its evidence.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Watchdogs: a task that blocks on flash past its budget panics loudly
CONFIG_ESP_TASK_WDT_INIT=y

# Panic handling + coredump partition (03 §3.7)
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Power: tickless idle + DFS-capable
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Trim Wi-Fi buffers — we move kilobytes, not megabits (01 §1.4)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Board-found (M2 sitting): the default 2304 B sys_evt stack overflows
# under our event chain + esp_netif + mDNS re-announce on client join.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# IDF v6 never invokes the ws URI handler on the handshake GET; the
# open path (registry add, hello, current sample) runs in the post-
# handshake callback instead.
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
