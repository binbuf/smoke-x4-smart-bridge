# Heltec WiFi LoRa 32 V3 (ESP32-S3, 8 MB flash). Design 01 section 1.1.
# Apply after sdkconfig.defaults:
#   idf.py -B build \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.heltec-v3" build
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# Vendored ra01s SX1262 driver (T12). Heltec V3 pin map from design 01 §1.2.
# The frequency choice is only the driver's menu default; sx_radio passes the
# runtime frequency explicitly. Keep it valid so a fresh config does not fall
# back to the Kconfig default of 433 MHz.
CONFIG_915MHZ=y
CONFIG_MISO_GPIO=11
CONFIG_MOSI_GPIO=10
CONFIG_SCLK_GPIO=9
CONFIG_NSS_GPIO=8
CONFIG_RST_GPIO=12
CONFIG_BUSY_GPIO=13
CONFIG_TXEN_GPIO=-1
CONFIG_RXEN_GPIO=-1
CONFIG_SPI2_HOST=y
