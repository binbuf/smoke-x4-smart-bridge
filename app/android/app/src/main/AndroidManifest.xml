<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A14.3 — the network rows of the 05 §5.8.3 matrix. BLE rows land
         with A6 (M3), foreground-service rows with A13 (M5). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <!-- Without this, mDNS silently finds nothing — the worst kind of
         bug: multicast receive is filtered at the Wi-Fi driver. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- API 33+: nearby-device discovery without a location prompt.
         neverForLocation is load-bearing — a future dependency must not
         quietly turn scanning into a location permission. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"/>
    <!-- API <= 32 needed location for Wi-Fi scans (and API <= 30 needed it
         for BLE scans too); gated to those levels only. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32"/>
    <!-- A6.6 — the BLE rows of the same §5.8.3 matrix, which A14.3 left
         for M3. API 31+ (Android 12): the modern split, with
         neverForLocation on the scan half so onboarding never triggers a
         location prompt — a meaningful drop-off point. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- API <= 30: the legacy pair. ACCESS_FINE_LOCATION above covers the
         third leg of the legacy trio on those levels. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <!-- A13.5 — the foreground-service rows (09 §9.6). The TYPE is
         required from Android 14 and omitting it is a CRASH rather than
         a warning; ours is connectedDevice because that is what the
         service does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- API 33+. Requested when the FIRST cook starts, not at launch: a
         prompt before the user has seen anything work is the classic way
         to get it denied permanently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The §9.6 opt-in. Several OEM builds kill long-running foreground
         services regardless of type; declining degrades the app to
         "reconnects and catches up when you open it", which still works
         because the DEVICE never stopped recording. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- newapp §G.4 — THE MECHANISM THAT LIGHTS THE SCREEN AT 3 A.M.
         Without this a critical alarm is a notification you find in the
         morning, which is the entire failure this product exists to
         prevent. Since 22 January 2025, apps targeting Android 14+ only
         get it granted by default if they have calling or ALARM
         functionality — this app qualifies as an alarm app, and the Play
         Console declaration (mandatory since 31 May 2024) says so. The
         user can still revoke it, so `NotificationSink.canUseFullScreenIntent`
         checks at runtime rather than assuming. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- §G.4 — time-based rules (an amount elapsed, a time before the end)
         must fire ON TIME in Doze, not whenever the OS next feels like it.
         USE_EXACT_ALARM is the alarm-app grant that needs no runtime
         prompt; SCHEDULE_EXACT_ALARM is the pre-33 fallback. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>
    <!-- The wake lock the monitor holds between 30 s ticks. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="smoke_bridge"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- newapp §G.4 — the background monitor, and the ONE attribute that
             decides whether a fourteen-hour cook survives.
             `flutter_foreground_task` does not declare this service in its own
             manifest; the app must, and the type declared here is the type the
             OS enforces whatever Dart asks for.

             It is `connectedDevice`, deliberately and not `dataSync`:
             Android 15's behaviour-changes doc states that "the system permits
             dataSync and mediaProcessing foreground services to run for a total
             of 6 hours in a 24-hour period, after which the system calls
             Service.onTimeout()". Six hours is a third of a brisket. A cook
             that goes silent at hour six, at 2 a.m., with the phone reporting
             nothing wrong, is the exact failure mode this whole product is
             built to prevent. `connectedDevice` carries no such cap — and it is
             also the truthful description of what the service does, which is
             stay attached to a BLE peripheral.

             Android 15 additionally broke background BLE scanning without
             `foregroundServiceType="connectedDevice"` plus
             FOREGROUND_SERVICE_CONNECTED_DEVICE, declared above.

             Warning: do not change the service name — the plugin binds it. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
