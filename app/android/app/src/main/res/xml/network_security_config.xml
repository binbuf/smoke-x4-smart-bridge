<?xml version="1.0" encoding="utf-8"?>
<!-- N15.2 (design 05 §5.8.4): the bridge serves plain HTTP — a self-signed
     cert on a clockless LAN device is worse than no cert. Named hosts get an
     explicit cleartext exemption; the base config permits cleartext because
     STA-mode DHCP addresses are private-range IPs Android's config cannot
     express as domains (documented trade-off; revisit if the app ever talks to
     anything off-LAN). This stays an NSC decision, never
     android:usesCleartextTraffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">smokebridge.local</domain>
        <domain includeSubdomains="false">192.168.4.1</domain>
    </domain-config>
</network-security-config>
