app.old/

# Build output
build/
firmware/build/
*.bin
!docs/reference/**/*.bin

# ESP-IDF: the generated root sdkconfig is per-checkout; per-board defaults ARE committed
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.heltec-v3.old
firmware/sdkconfig.heltec-v3-bench
firmware/sdkconfig.heltec-v3-bench.old
firmware/dependencies.lock
firmware/managed_components/

# Dart / Flutter
.dart_tool/
.packages
pubspec.lock
!app/pubspec.lock
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/.metadata
coverage/

# Python
__pycache__/
*.py[cod]
.venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Host test build trees
firmware/test/build*/
firmware/build-test/

# Packaged app artefacts. `build/` already covers the usual output path; these
# catch a copy dropped anywhere else (a shared APK, a signing key).
*.apk
*.aab
*.jks
*.keystore
.gradle/

# Generated bench/reference captures. These are working output from a bench
# session, not source; the reference screenshots that ARE inputs live under
# docs/reference/apps/ and are committed.
/artifacts/

# Logs and crash dumps — but NOT the committed capture fixtures, which are
# test inputs rather than noise (protocol/fixtures/board/*.log).
*.log
!protocol/fixtures/**/*.log
*.coredump

# Editor / OS leftovers not already covered
*~
*.tmp
.claude/
